# ──────────────────────────────────────────────────────────────
# QuantingV — Environment Variables
# Copy this file to .env and fill in your values.
# ──────────────────────────────────────────────────────────────

# ── GEMINI AI ─────────────────────────────────────────────────
# Get free key at: https://aistudio.google.com → "Get API key"
# Free tier: 1,500 requests/day
GEMINI_API_KEY=

# ── NEWS API ──────────────────────────────────────────────────
# Register free at: https://newsapi.org/register
# Free tier: 100 requests/day (developer plan)
NEWS_API_KEY=

# ── SUPABASE ──────────────────────────────────────────────────
# Create project at: https://supabase.com → New Project
# Then go to: Project Settings → API
#
# Project URL (Settings → API → Project URL)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
#
# anon/public key (Settings → API → Project API keys → anon public)
SUPABASE_ANON_KEY=
#
# service_role key (Settings → API → Project API keys → service_role secret)
# ⚠️  KEEP SECRET — never expose in frontend code
SUPABASE_SERVICE_KEY=
#
# Database connection string (Settings → Database → Connection string → URI)
# Replace [YOUR-PASSWORD] with your Supabase DB password
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# Local dev: http://localhost:5173
# Production: your Vercel URL, e.g. https://quantingv.vercel.app
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── FRONTEND (Vite) ───────────────────────────────────────────
# Set this in Vercel dashboard (Project → Settings → Environment Variables)
# Value: your Railway backend URL, e.g. https://quantingv-production.up.railway.app
# Leave blank for local dev (Vite proxy handles it)
VITE_API_URL=
